# ===== 运行时数据 =====
# 数据库可由 `mingoff init && mingoff seed` 重放，不入库。
# ⚠️ 一旦开始手工录入校勘成果（不可重放），要重新评估这一条 —— 见 docs/DECISIONS.md D3。
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.db

# 例外（D21/D23）：正式管线的版本化导出物是数据资产，必须入库
!src/mingoff/data/official_cabinet.json
!site/src/data/cabinet.json

# CBDB 快照等外部数据导入物（体量大、有独立许可，不入库）
imports/
*.csv
*.xlsx
*.xls
*.accdb
*.mdb

# ===== 设计决策与需求文档（本机资料，含未公开研究内容）=====
